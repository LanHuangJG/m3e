---
import { Code } from "astro:components";

interface Props {
  /** 形如 "button/0"，对应 src/demos/{name}.html 与 .code */
  name: string;
}

const previews = import.meta.glob("../demos/**/*.html", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
const sources = import.meta.glob("../demos/**/*.code", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

const { name } = Astro.props;
const html = previews[`../demos/${name}.html`] ?? "";
const code = (sources[`../demos/${name}.code`] ?? "").trimEnd();

function langOf(src: string): string {
  const c = src.trim();
  if (c.startsWith(".") || c.startsWith("{") || c.includes("--md-sys") || c.includes("/*")) return "css";
  if (c.includes("document.") || c.startsWith("const ") || c.includes("=>")) return "js";
  return "html";
}

const uid = "demo-" + Math.random().toString(36).slice(2, 8);
const isZh = Astro.url.pathname.startsWith("/zh");
const labels = isZh
  ? { open: "新窗口打开", copy: "复制代码", copied: "已复制", toggle: "查看代码" }
  : { open: "Open in new tab", copy: "Copy code", copied: "Copied", toggle: "View code" };
---

<figure class="demo" id={uid}>
  <div class="demo-preview" set:html={html}></div>
  <div class="demo-actions">
    <a
      class="demo-btn"
      href={`/demo/${name}/`}
      target="_blank"
      rel="noopener"
      aria-label={labels.open}
      title={labels.open}
    >
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 3h6v6"></path><path d="M10 14 21 3"></path>
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
      </svg>
    </a>
    <button type="button" class="demo-btn" data-demo-action="copy" aria-label={labels.copy} title={labels.copy}>
      <svg class="icon icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
      <svg class="icon icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </button>
    <button
      type="button"
      class="demo-btn"
      data-demo-action="toggle"
      aria-expanded="false"
      aria-controls={`${uid}-code`}
      aria-label={labels.toggle}
      title={labels.toggle}
    >
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
    </button>
  </div>
  {
    code && (
      <div class="demo-code" id={`${uid}-code`} hidden>
        <Code code={code} lang={langOf(code)} theme="github-light" />
      </div>
    )
  }
  {
    code && (
      <button type="button" class="demo-float" data-demo-action="toggle">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m18 15-6-6-6 6" />
        </svg>
        <span>{isZh ? "隐藏代码" : "Hide code"}</span>
      </button>
    )
  }
</figure>
