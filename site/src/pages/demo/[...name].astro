---
export function getStaticPaths() {
  const previews = import.meta.glob("../../demos/**/*.html", {
    query: "?raw",
    import: "default",
    eager: true,
  }) as Record<string, string>;
  return Object.entries(previews).map(([path, html]) => {
    const name = path.replace("../../demos/", "").replace(/\.html$/, "");
    const [lang, component, index] = name.split("/");
    return { params: { name }, props: { html, component, index } };
  });
}

const { html, component, index } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{component} · 示例 {index} · M3E</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0"
      rel="stylesheet"
    />
    <script type="module" src="/m3e/all.min.js"></script>
    <style>
      body {
        margin: 0;
        padding: 24px;
        font-family: "Roboto", system-ui, sans-serif;
        background: var(--md-sys-color-surface, #fef7ff);
        color: var(--md-sys-color-on-surface, #1c1b1e);
      }
    </style>
  </head>
  <body>
    <m3e-theme>
      <div set:html={html}></div>
    </m3e-theme>
  </body>
</html>
